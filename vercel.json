        { "source": "/services/distributed-training/", "destination": "/networking#design", "statusCode": 301 },
        { "source": "/services/gpu-networking", "destination": "/networking", "statusCode": 301 },
        { "source": "/services/gpu-networking/", "destination": "/networking", "statusCode": 301 },
        { "source": "/services/gpu-kubernetes", "destination": "/networking#run", "statusCode": 301 },
        { "source": "/services/gpu-kubernetes/", "destination": "/networking#run", "statusCode": 301 },
        { "source": "/services/gpu-monitoring", "destination": "/networking#run", "statusCode": 301 },
